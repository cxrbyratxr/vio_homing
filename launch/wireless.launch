<launch>
  <!-- Use scripts/run_wireless.sh to select the ROS network environment. -->
  <arg name="jetson_ip" default="192.168.50.1"/>
  <arg name="qgc_peer_ip" default="192.168.50.24"/>
  <arg name="baudrate" default="460800"/>
  <arg name="imu_rate_hz" default="200"/>
  <arg name="enable_camera" default="true"/>
  <arg name="enable_video" default="true"/>
  <arg name="camera_device" default="/dev/v4l/by-id/usb-Global_Shutter_Camera_Global_Shutter_Camera_01.00.00-video-index0"/>
  <arg name="camera_info_file" default=""/>
  <include file="$(find vio_homing)/launch/companion.launch">
    <arg name="baudrate" value="$(arg baudrate)"/>
    <arg name="imu_rate_hz" value="$(arg imu_rate_hz)"/>
    <arg name="enable_qgc_link" value="true"/>
    <arg name="qgc_bind_ip" value="$(arg jetson_ip)"/>
    <arg name="qgc_peer_ip" value="$(arg qgc_peer_ip)"/>
    <arg name="link_source" value="qgc"/>
    <arg name="link_ok_timeout" value="2.0"/>
    <arg name="link_lost_timeout" value="4.0"/>
    <arg name="enable_camera" value="$(arg enable_camera)"/>
    <arg name="camera_device" value="$(arg camera_device)"/>
    <arg name="camera_fourcc" value="YUYV"/>
    <arg name="camera_grayscale" value="false"/>
    <arg name="camera_info_file" value="$(arg camera_info_file)"/>
    <!-- Homing command and alignment gates retain false defaults. -->
  </include>
  <node if="$(arg enable_video)" pkg="web_video_server" type="web_video_server"
        name="web_video_server" output="screen">
    <param name="address" value="$(arg jetson_ip)"/>
    <param name="port" value="8080"/>
  </node>
</launch>
