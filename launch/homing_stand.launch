<launch>
  <!-- Use a separate ROS master for this stand; see HOMING_STAND.md. -->
  <arg name="run_simulator" default="true"/>
  <arg name="heartbeat_port" default="15051"/>
  <arg name="result_file" default="/tmp/vio_homing_stand_result.json"/>

  <node pkg="vio_homing" type="wifi_link_monitor.py" name="stand_link_monitor" output="screen">
    <param name="bind_address" value="127.0.0.1"/>
    <param name="port" value="$(arg heartbeat_port)"/>
    <param name="ok_timeout" value="0.5"/>
    <param name="lost_timeout" value="3.0"/>
    <param name="publish_rate" value="20.0"/>
  </node>
  <node pkg="vio_homing" type="trajectory_recorder.py" name="stand_trajectory_recorder" output="screen">
    <param name="odom_topic" value="/vio/odom_frd"/>
    <param name="min_point_distance" value="0.25"/>
    <param name="max_point_interval" value="1.0"/>
  </node>
  <node pkg="vio_homing" type="homing_manager.py" name="stand_homing_manager" output="screen">
    <param name="odom_topic" value="/vio/odom_frd"/>
    <param name="wait_link_seconds" value="60.0"/>
  </node>
  <node if="$(arg run_simulator)" pkg="vio_homing" type="homing_stand_sim.py"
        name="homing_stand_sim" output="screen" required="true">
    <param name="heartbeat_port" value="$(arg heartbeat_port)"/>
    <param name="result_file" value="$(arg result_file)"/>
  </node>
</launch>
