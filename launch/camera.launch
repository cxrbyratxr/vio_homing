<launch>
  <!-- Camera only: never opens UART or starts another companion stack. -->
  <arg name="device" default="/dev/video0"/>
  <arg name="width" default="640"/>
  <arg name="height" default="480"/>
  <arg name="fps" default="30"/>
  <arg name="fourcc" default="MJPG"/>
  <arg name="camera_info_file" default=""/>
  <node pkg="vio_homing" type="usb_camera_node.py" name="usb_camera" output="screen">
    <param name="device" value="$(arg device)"/>
    <param name="width" value="$(arg width)"/>
    <param name="height" value="$(arg height)"/>
    <param name="fps" value="$(arg fps)"/>
    <param name="fourcc" value="$(arg fourcc)"/>
    <param name="camera_info_file" value="$(arg camera_info_file)"/>
    <param name="frame_id" value="camera_optical_frame"/>
    <param name="grayscale" value="true"/>
  </node>
</launch>
